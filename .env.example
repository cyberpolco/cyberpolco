# ─── Database (required) ─────────────────────────────────────────────────
# Neon Postgres connection string — create a free database at neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Admin auth (required) ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-random-64-char-hex-string

# Bootstrap-only: used to auto-create the first Super Admin account (in the
# `users` table) the very first time anyone logs in after this table exists.
# Once that account is created, these two vars are never read again — manage
# users from /admin/users from then on.
ADMIN_EMAIL=admin@cyberpolco.com
# Generate with: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
ADMIN_PASSWORD_HASH=$2b$10$BYJY2qkuW3cuUBr5OkuZFu0nEgJYvFBrSjD6uqSAoQsd07MF2XrGO

# ─── Email (optional — falls back to console logging in dev) ────────────
RESEND_API_KEY=
EMAIL_FROM="Cyber PolCo <notifications@cyberpolco.com>"

# ─── File storage for CV uploads (optional — falls back to local disk) ──
BLOB_READ_WRITE_TOKEN=

# ─── CAPTCHA (optional — widget hidden until configured) ────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Cron (required for the Starlink subscription-reminder job) ─────────
# Authorizes Vercel Cron's daily request to /api/cron/starlink-subscription-
# reminders (see vercel.json) — that route has no logged-in admin session
# to check, so it checks this shared secret instead.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ─── PawaPay payments (required once webhook callbacks are wired up) ────
# Authorizes inbound PawaPay callbacks to /api/pawapay/*/callback — see
# lib/pawapay/verify.ts. Set to "bearer" or "hmac" depending on which
# mechanism PawaPay's dashboard is configured to use (confirm against their
# docs — this repo implements both, gated by this switch). Left unset, all
# four callback routes reject every request with 401.
PAWAPAY_WEBHOOK_AUTH_MODE=
# The shared secret/token PawaPay signs or sends with each callback.
PAWAPAY_WEBHOOK_SECRET=
# PawaPay's API token for creating deposits (lib/pawapay/client.ts). Not
# read by the callback routes themselves.
PAWAPAY_API_KEY=
# Defaults to https://api.sandbox.pawapay.io if unset — only set this to
# PawaPay's production base URL once you're ready to take real payments.
PAWAPAY_BASE_URL=

# EC P-256 key pair registered in PawaPay's dashboard for RFC-9421 request
# signing (lib/pawapay/client.ts). Generate with:
#   openssl ecparam -name prime256v1 -genkey -noout -out private-key.pem
#   openssl ec -in private-key.pem -pubout -out public-key.pem
# Paste public-key.pem's contents into PawaPay's dashboard (Developer
# settings → Public keys) along with a key ID of your choosing, then set
# both here.
# PawaPay enforces signing per-account via a dashboard toggle — once
# enabled (sandbox or production), unsigned requests get HTTP 401
# HTTP_SIGNATURE_ERROR. Leave both unset to send unsigned requests.
PAWAPAY_SIGNING_KEY_ID=
PAWAPAY_SIGNING_PRIVATE_KEY=
